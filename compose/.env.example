# Copy to .env and adjust. Every value is optional — defaults shown.

# Host port the portal listens on
PORT=3000

# URL learners use to reach the portal (used for OIDC redirects and cookies)
PUBLIC_URL=http://localhost:3000

# Registry prefix for learner/course images without an explicit registry
IMAGE_REGISTRY=ghcr.io/admuppy

# Default learner environment (Linux track); k8s/exam tracks pick theirs from course.json
LEARNER_IMAGE=snacklab-linux:v2

DEFAULT_LOCALE=en          # ko en ja zh-CN zh-TW es de
ADMIN_USERS=admin          # comma-separated portal admin usernames

MAX_SESSIONS=8             # global concurrent session cap (single host — size to your RAM/CPU)
MAX_SESSIONS_PER_USER=1
TTL_MINUTES=40
EXTEND_MINUTES=30
IDLE_MINUTES=15
IDLE_GRACE_MINUTES=5
WARM_POOL_SIZE=1           # pre-booted learner containers for instant session start

# Persistent cookie-signing secret (any long random string); if empty, one is
# generated inside the container and logins reset when it is recreated.
COOKIE_SECRET=
